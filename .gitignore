# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 키가 들어 있는 .env / .env.local 등은 절대 커밋하지 않음
.env*
# 키 이름만 있는 예시 파일은 커밋
!.env.example

# vercel
.vercel

# Claude Code 개인 설정 (launch.json은 공유)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
