# Safe Bike Seoul 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 .gitignore 에 있어 커밋되지 않습니다)
#
# ─ 서버 전용 키 ─────────────────────────────────────────────
# NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요. 접두사가 없으면 브라우저 번들에 포함되지 않고
# src/lib/server/* (API Route)에서만 읽힙니다.

# 카카오 REST API 키 (장소 검색)      https://developers.kakao.com
KAKAO_REST_API_KEY=

# 서울 열린데이터광장 인증키 (따릉이 실시간 대여정보)  https://data.seoul.go.kr
SEOUL_API_KEY=

# 공공데이터포털 인증키 (기상청 단기예보, 에어코리아, 도로교통공단 사고다발지역)  https://www.data.go.kr
# '일반 인증키(Decoding)' 값을 권장합니다. Encoding 값도 동작합니다.
DATA_GO_KR_API_KEY=

# ─ 외부 API 일일 호출 한도 (선택, 서비스 전체 · 매일 0시 KST 초기화) ──
# 캐시에 없어 실제로 외부 API를 부를 때만 셉니다. 비워 두면 기본값을 씁니다.
# 카카오 자전거 경로: 공식 무료 1,000건/일 → 기본 900
KAKAO_BIKE_ROUTE_DAILY_LIMIT=
# 카카오 장소 검색: 공식 무료 100,000건/일 → 기본 90000
KAKAO_LOCAL_DAILY_LIMIT=

# ─ 브라우저 공개 키 ─────────────────────────────────────────
# 카카오맵 JavaScript 키는 구조상 브라우저에 노출됩니다.
# Kakao Developers › 플랫폼 › Web 에 허용 도메인을 등록해 다른 사이트에서 쓰지 못하게 하세요.
NEXT_PUBLIC_KAKAO_JS_KEY=
